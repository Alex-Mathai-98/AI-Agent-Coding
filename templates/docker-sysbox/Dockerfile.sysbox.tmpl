# =============================================================================
# Dockerfile.sysbox — rendered from .claude/templates/docker-sysbox/init.sh
# [GENERIC] sections rarely change; [PROJECT] sections come from newproject.conf.
# AIDEV-NOTE: do not edit rendered output; edit the .tmpl or newproject.conf instead.
# =============================================================================
FROM @@BASE_IMAGE@@

# --- [PROJECT] system packages (language runtime, build tools) ---
RUN apt-get update && apt-get install -y \
    @@SYSTEM_PACKAGES@@ \
    && rm -rf /var/lib/apt/lists/*

# --- [GENERIC] Node.js + Claude Code + jq + git safe.directory ---
COPY docker/setup_sysbox.sh /tmp/setup_sysbox.sh
RUN APP_DIR=@@WORKDIR@@ bash /tmp/setup_sysbox.sh && rm /tmp/setup_sysbox.sh

WORKDIR @@WORKDIR@@

# --- [PROJECT] dependency install ---
@@DEP_INSTALL@@

# --- [GENERIC] per-checkout venvs: the system Python must not provide the project ---
# AIDEV-NOTE: each checkout (primary and every worktree) gets its own .venv with an editable
# install of itself (.claude/worktrunk/make-venv.sh). Anything global (a system install,
# PYTHONPATH) would make every worktree silently run one checkout's code.
# pip >= 23 honours the PEP 668 marker below; uv creates the venvs.
RUN pip install --no-cache-dir -U "pip>=23" uv
# The build fails if the system Python can import any of these (newproject.conf).
RUN for m in @@SYSTEM_PYTHON_FORBIDDEN_IMPORTS@@; do \
      ! env -u PYTHONPATH python3 -c "import $m" 2>/dev/null \
      || { echo "system python3 provides $m: install it in a venv instead" >&2; exit 1; }; \
    done
# PEP 668 marker: pip / uv refuse installs into the system Python (venvs are not affected).
# The image's last pip use: nothing after this point installs into the system Python.
RUN printf '[externally-managed]\nError=Use a venv: uv venv .venv && uv pip install -e .\n' \
    > "$(python3 -c 'import sysconfig; print(sysconfig.get_path("stdlib"))')/EXTERNALLY-MANAGED"

# --- [PROJECT] copy application files ---
@@PROJECT_COPY@@

# --- [GENERIC] interactive shell: tmux + zsh (oh-my-zsh, powerlevel10k) ---
COPY docker/ ./docker/
RUN bash docker/setup_shell.sh root
ENV LANG=en_US.UTF-8

# --- [PROJECT] environment variables ---
@@ENV_VARS@@

# --- [GENERIC] systemd as PID 1 (required for inner Docker daemon) ---
ENTRYPOINT ["/sbin/init"]
