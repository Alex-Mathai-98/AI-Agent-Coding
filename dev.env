# Email notification settings (for regression_email_notifier.py)
# Required - comma-separated recipient list
EMAIL_RECIPIENTS="to1@gmail.com,to2@gmail.com"

# Required - SMTP server settings
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="from@gmail.com"
SMTP_PASSWORD="<password here>"

# Project settings
PROJECT_NAME="YOUR-PROJECT-NAME"

# --- worktrunk (parallel agent worktrees) ---
# Put `wt` on PATH. Default is cargo's bin dir (from `cargo install worktrunk`);
# change it if you installed wt elsewhere (Homebrew, /usr/local/bin, a prebuilt binary).
# AIDEV-NOTE: no WORKTRUNK_PROJECT_CONFIG_PATH here on purpose. The project config lives at the
# tracked default path .config/wt.toml, so `wt switch --create` seeds worktrees out of the box
# without sourcing this file. Setting the override would suppress that config entirely.
PATH="$HOME/.cargo/bin:$PATH"